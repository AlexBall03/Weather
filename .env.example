# ---------------------------------------------------------------------------
# Weather — weather.alexball.dev
# Copy to .env.local for local development. Both values are server-only:
# neither is prefixed with NEXT_PUBLIC_, so neither reaches the browser bundle.
# ---------------------------------------------------------------------------

# National Weather Service (api.weather.gov)
#
# NWS has no accounts and no API keys. It asks only that every client identify
# itself with a User-Agent that includes a way to contact the operator, so the
# service can reach you about a problem before it blocks you.
#
# Format: AppName/Version (domain, contact-email)
# If this is unset the app falls back to "Weather/1.0 (weather.alexball.dev)",
# which works but gives NWS no way to reach you. Set it properly in production.
NWS_USER_AGENT="Weather/1.0 (weather.alexball.dev, you@example.com)"

# Mapbox Geocoding API v6 — used ONLY to turn typed text into coordinates.
# No weather data ever comes from Mapbox.
#
# Without this value: typed location search returns a clear configuration
# message, and Use My Location plus the quick locations keep working.
MAPBOX_ACCESS_TOKEN=

# Optional. Points the NWS client at a different base URL — useful for
# exercising the "NWS unavailable" state locally. Leave unset in production.
# NWS_BASE_URL=https://api.weather.gov
